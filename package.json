{
  "name": "hermes-nudge",
  "version": "0.4.0",
  "license": "MIT",
  "description": "A local-first desktop companion for Hermes Agent",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test-shell.cjs test-client.cjs test-notification-rules.cjs",
    "package": "electron-packager . \"Woof\" --platform=darwin --arch=arm64 --no-asar --out=dist --icon=assets/Nudge.icns --app-bundle-id=com.redcirclestudio.hermesnudge --overwrite --ignore=\"^/(dist|docs|test.*|verify-.*|create-icon.*|__pycache__|evidence|assets|scripts|backend.py|README.*|SECURITY.md|CONTRIBUTING.md|package-lock.json|.github|.gitignore)|^/web/sounds/(woof.wav|wolf-bark.mp3)$\" && python3 scripts/trim_client.py"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.6.0",
    "playwright": "^1.63.0"
  }
}
